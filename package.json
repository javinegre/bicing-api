{
  "name": "@negre-co/bicing-api",
  "version": "0.0.1",
  "description": "Bicing API",
  "main": "index.ts",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint --fix 'src/**/*.ts'",
    "format": "prettier --write 'src/**/*.{js,jsx,ts,tsx,css,md,json}' --config ./.prettierrc",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/javinegre/bicing-api.git"
  },
  "keywords": [
    "Barcelona",
    "Bicing",
    "API"
  ],
  "author": "javi.negre@gmail.com",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/javinegre/bicing-api/issues"
  },
  "homepage": "https://github.com/javinegre/bicing-api#readme",
  "dependencies": {
    "@types/memory-cache": "^0.2.2",
    "axios": "^1.2.0",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-cors": "^0.0.3",
    "memory-cache": "^0.2.0",
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^5.45.0",
    "@typescript-eslint/parser": "^5.45.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^8.28.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-prettier": "^4.2.1",
    "prettier": "^2.8.0",
    "vitest": "^4.1.11",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.21",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true
  }
}
